{
  "expo": {
    "name": "Buscador de libros",
    "slug": "27-buscador-de-libros-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "buscadordelibros",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.buscadorlibros.app",
      "supportsTablet": false
    },
    "android": {
      "package": "com.buscadorlibros.app",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "permissions": ["android.permission.CAMERA"],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ],
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "La cámara se usa solo para escanear el código de barras ISBN de un libro.",
          "recordAudioAndroid": false
        }
      ],
      "expo-sqlite",
      "expo-secure-store"
    ]
  }
}
